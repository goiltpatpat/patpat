{
  "description": "Session-scoped Patpat Loop lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "PATPAT_PLUGIN_ROOT=\"${PLUGIN_ROOT:-${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}}\"; if [ -n \"$PATPAT_PLUGIN_ROOT\" ]; then python3 \"$PATPAT_PLUGIN_ROOT/hooks/scripts/patpat_loop_state.py\"; fi",
            "timeout": 2,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATPAT_PLUGIN_ROOT=\"${PLUGIN_ROOT:-${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}}\"; if [ -n \"$PATPAT_PLUGIN_ROOT\" ]; then python3 \"$PATPAT_PLUGIN_ROOT/hooks/scripts/patpat_loop_state.py\"; fi",
            "timeout": 2,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATPAT_PLUGIN_ROOT=\"${PLUGIN_ROOT:-${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}}\"; if [ -n \"$PATPAT_PLUGIN_ROOT\" ]; then python3 \"$PATPAT_PLUGIN_ROOT/hooks/scripts/patpat_loop_state.py\"; fi",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
